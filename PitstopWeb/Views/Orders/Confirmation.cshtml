@model Order
@{
    ViewData["Title"] = "Потвърждение на поръчка";

    string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "Изчаква плащане",
        OrderStatus.Paid => "Платена",
        OrderStatus.Shipped => "Изпратена",
        OrderStatus.Delivered => "Доставена",
        OrderStatus.Cancelled => "Отказана",
        _ => s.ToString(),
    };
}

<div class="confirmation-page">
    <h1 class="section-title">Благодарим за поръчката!</h1>
    <p class="text-muted">Номер на поръчка: <span class="font-monospace">@Model.Id</span></p>
    <p>Статус: <span class="text-brand fw-bold">@StatusLabel(Model.Status)</span></p>

    <div class="order-summary-card text-start mt-4">
        <h2 class="order-summary-title">Продукти</h2>
        @foreach (var item in Model.Items)
        {
            <div class="order-summary-row">
                <span class="text-muted">@item.Product.Name × @item.Quantity</span>
                <span>@((item.PriceAtPurchase * item.Quantity).ToString("N2")) €</span>
            </div>
        }
        <div class="order-summary-total">
            <span>Общо</span>
            <span>@Model.Total.ToString("N2") €</span>
        </div>

        <div class="mt-3 text-muted small">
            <div>@Model.ShippingName</div>
            <div>@Model.ShippingAddress</div>
            <div>@Model.ShippingCity</div>
            <div>@Model.Phone</div>
        </div>
    </div>

    <a asp-controller="Products" asp-action="Index" class="btn btn-brand mt-4">Продължи пазаруването</a>
</div>
