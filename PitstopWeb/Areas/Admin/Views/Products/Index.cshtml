@model List<Product>
@{
    ViewData["Title"] = "Продукти";
}

<div class="admin-header-row">
    <h1 class="admin-title">Продукти</h1>
    <a asp-action="Create" class="btn btn-brand">+ Нов продукт</a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Продукт</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Наличност</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <div class="fw-medium">@p.Name</div>
                        <div class="small text-muted">@p.Brand · @p.Sku</div>
                    </td>
                    <td>@p.Category.Name</td>
                    <td>@p.Price.ToString("N2") €</td>
                    <td class="@(p.Stock <= 5 ? "text-brand fw-bold" : "")">@p.Stock</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Редакция</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Изтриване на &quot;@p.Name&quot;?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Изтрий</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
