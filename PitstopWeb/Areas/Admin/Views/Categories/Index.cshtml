@model List<Category>
@{
    ViewData["Title"] = "Категории";
}

<h1 class="admin-title">Категории</h1>

<form asp-action="Create" method="post" class="admin-inline-form mb-4">
    @Html.AntiForgeryToken()
    <div>
        <label class="form-label">Нова категория</label>
        <input type="text" name="name" class="form-control" placeholder="напр. Аксесоари" required />
    </div>
    <button type="submit" class="btn btn-brand">Добави</button>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Име</th>
                <th>Slug</th>
                <th>Продукти</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-medium">@c.Name</td>
                    <td class="text-muted">@c.Slug</td>
                    <td>@c.Products.Count</td>
                    <td class="text-end">
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Изтриване на категория &quot;@c.Name&quot;?');">
                            @Html.AntiForgeryToken()
                            @if (c.Products.Any())
                            {
                                <button type="submit" class="btn btn-outline-danger btn-sm" disabled title="Има продукти в тази категория">Изтрий</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-danger btn-sm">Изтрий</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
