<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PITSTOP admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-brand">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-logo">
                    PIT<span class="text-brand">STOP</span>
                    <span class="admin-badge">admin</span>
                </a>
            </div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Табло</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">Продукти</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Категории</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Поръчки</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-muted">Към сайта</a>
            </nav>
        </aside>
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
